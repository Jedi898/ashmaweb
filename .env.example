# ─────────────────────────────────────────────────────────────────────────────
# Ashma Singh Thakuri — Environment Variables
# Copy this file to `.env.local` and fill in your values. Never commit `.env*`.
# ─────────────────────────────────────────────────────────────────────────────

# Your production site URL (used for sitemap, robots.txt, canonical links,
# and OpenGraph metadata). On Vercel you can set this in Project Settings →
# Environment Variables, or leave it to fall back to the default Vercel URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
